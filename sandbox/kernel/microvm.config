# Architecture
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2

# Hypervisor support
CONFIG_HYPERVISOR_GUEST=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_CLOCK=y

# Boot / init
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y

# Console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PRINTK=y

# No modules (nomodule)
CONFIG_MODULES=n

# Timer
CONFIG_HZ_250=y

# Preempt
CONFIG_PREEMPT_DYNAMIC=y

# ACPI (required by Firecracker)
CONFIG_ACPI=y
# PCI enabled: CONFIG_PCI=y is required on x86_64 for ACPI to boot
# (acpi_gbl_default_address_spaces includes PCI_CONFIG, whose handler is
# compiled out unless CONFIG_PCI is set -> AE_BAD_PARAMETER -> SDT load
# fails -> IRQ setup broken -> virtio probes fail with -EINVAL).
# Firecracker does not emulate PCI config ports (0xcf8/0xcfc), so we boot
# with "pci=off" to skip PCI probing at runtime (matches FC reference setup).
CONFIG_PCI=y
CONFIG_PCI_MSI=y
# CONFIG_PCI_HOST_GENERIC is not set
# CONFIG_PCIEPORTBUS is not set

# VirtIO (MMIO for Firecracker)
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_BALLOON=y
# CONFIG_VIRTIO_PCI is not set (PCI disabled)

# Block
CONFIG_BLK_DEV=y
CONFIG_BLK_MQ_PCI=y
CONFIG_BLK_MQ_VIRTIO=y
CONFIG_MSDOS_PARTITION=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_FUSE_FS=y
CONFIG_FUSE_IO_URING=y

# io_uring
CONFIG_IO_URING=y

# Security / random
CONFIG_RANDOM_TRUST_CPU=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y

# Networking (minimal)
CONFIG_INET=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_FAILOVER=y
CONFIG_FAILOVER=y
CONFIG_DIMLIB=y

# cgroups
CONFIG_CGROUPS=y
CONFIG_CGROUP_MEMORY=y
CONFIG_MEMCG=y

# Disable unused
CONFIG_SOUND=n
CONFIG_USB=n
CONFIG_DRM=n
CONFIG_INPUT=n
CONFIG_THERMAL=n
CONFIG_DEVTMPFS=y
